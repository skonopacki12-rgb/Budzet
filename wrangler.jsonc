{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "budzet",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "budzet",
			// Placeholder — replace with the real id printed by
			// `npx wrangler d1 create budzet` (see README "Wdrożenie na
			// Cloudflare"). Local `wrangler dev` / `next dev` work fine with
			// the placeholder since they use a local SQLite file, not this id.
			"database_id": "REPLACE_WITH_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	]
}
